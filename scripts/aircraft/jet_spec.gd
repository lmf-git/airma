class_name JetSpec
## Airframe database. Flight numbers are in SI (kg, m, N, N*m) and roughly
## track the real aircraft; geometry is a compact recipe read by JetFactory.


const FACTIONS := {
	"usa": {"name": "UNITED STATES", "bloc": "nato"},
	"uk": {"name": "UNITED KINGDOM", "bloc": "nato"},
	"france": {"name": "FRANCE", "bloc": "nato"},
	"russia": {"name": "RUSSIA", "bloc": "opfor"},
	"china": {"name": "CHINA", "bloc": "opfor"},
	"iran": {"name": "IRAN", "bloc": "opfor"},
	"civil": {"name": "CIVIL", "bloc": "neutral"},
}

static func ids() -> PackedStringArray:
	return PackedStringArray(["f22", "f35", "f16", "f15", "a10", "su57", "su35", "mig29",
		"j20", "typhoon", "rafale", "ac130", "c130",
		"ah64", "mi28", "z10", "tiger", "a320", "dash8", "c172", "bell206"])

static func ids_for(faction: String) -> PackedStringArray:
	var out := PackedStringArray()
	for id in ids():
		if faction == "" or String(get_spec(id).get("faction", "usa")) == faction:
			out.append(id)
	return out

static func is_rotary(id: String) -> bool:
	return bool(get_spec(id).get("rotary", false))

static func bloc_of(id: String) -> String:
	var f := String(get_spec(id).get("faction", "usa"))
	return String(FACTIONS.get(f, {}).get("bloc", "nato"))

static func get_spec(id: String) -> Dictionary:
	var all := _db()
	return all.get(id, all["f22"])

